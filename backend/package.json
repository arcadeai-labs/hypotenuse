{
  "name": "hypotenuse-backend",
  "version": "0.0.1",
  "description": "Hypotenuse — a persistent multiplayer, multichannel agent for your team, powered by Keryx",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "keryx": "keryx.ts"
  },
  "scripts": {
    "start": "bun keryx.ts start",
    "dev": "bun --watch keryx.ts start",
    "migrations": "bun run migrations.ts",
    "workspace:setup": "bun run scripts/setup-workspace.ts",
    "test": "bun test",
    "lint": "tsc && biome check .",
    "format": "tsc && biome check --write ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "keryx": "^0.48.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
