{
  "name": "hypotenuse-backend",
  "version": "0.0.1",
  "description": "Hypotenuse hosted service — Linear ingress, routing, and the runner API, powered by Keryx",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "keryx": "keryx.ts"
  },
  "scripts": {
    "start": "bun keryx.ts start",
    "dev": "bun --watch keryx.ts start",
    "migrations": "bun run migrations.ts",
    "workspace:setup": "bun run scripts/setup-workspace.ts",
    "test": "bun run finear:fetch && bun test",
    "lint": "tsc && biome check .",
    "format": "tsc && biome check --write .",
    "finear:fetch": "bun run scripts/fetch-finear.ts"
  },
  "dependencies": {
    "@hypotenuse/protocol": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "keryx": "^0.48.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@linear/sdk": "97.1.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "graphql": "16.11.0",
    "typescript": "^7.0.2"
  }
}
