{
  "name": "hypotenuse-backend",
  "version": "0.0.1",
  "description": "Hypotenuse \u2014 a persistent multiplayer, multichannel agent for your team, powered by Keryx",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "keryx": "keryx.ts"
  },
  "scripts": {
    "start": "bun keryx.ts start",
    "dev": "bun --watch keryx.ts start",
    "migrations": "bun run migrations.ts",
    "workspace:setup": "bun run scripts/setup-workspace.ts",
    "test": "bun test",
    "lint": "tsc && biome check .",
    "format": "tsc && biome check --write .",
    "slack:fetch-spec": "bun run scripts/fetch-slack-spec.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/gateway": "4.0.129",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@ai-sdk/provider": "4.0.34",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.156",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "keryx": "^0.48.2",
    "nodemailer": "^10.2.1",
    "run": "2.1.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
