# The image the sandbox lifecycle suite provisions against — TEST ONLY.
#
#   cd backend && bun run sandbox:build-test-image
#
# `Dockerfile.dev` minus the real coding CLIs, plus `stub-claude.sh` and
# `stub-codex.sh` standing in for `claude` and `codex` (both `stub-agent.ts`). Everything else is real: the container, the supervisor,
# the HTTP ingest, our MCP server, the proxies. The stub plays a scenario
# written into its task and calls our MCP tools for real, so the suite
# asserts the orchestration with no model, no key, and no network beyond us.
FROM oven/bun:1

# git and curl, so a job on a repository clones through the credential
# helper exactly as it does in the development image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/*

COPY stub-claude.sh /usr/local/bin/claude
COPY stub-codex.sh /usr/local/bin/codex
COPY stub-agent.ts /usr/local/lib/hypotenuse/stub-agent.ts
RUN chmod 0755 /usr/local/bin/claude /usr/local/bin/codex \
  && chmod 0644 /usr/local/lib/hypotenuse/stub-agent.ts

# The same non-root account as the development image.
RUN groupmod -n agent bun \
  && usermod -l agent -d /home/agent -m bun \
  && mkdir -p /work && chown agent:agent /work
WORKDIR /work
USER agent
