# One file covers development and test: `loadFromEnvIfSet` reads `${VAR}_${NODE_ENV}`
# before `${VAR}`, so the `_TEST` variants select themselves under `bun test`.

NODE_ENV=development
PROCESS_NAME=hypotenuse
PROCESS_NAME_TEST=hypotenuse-test
PROCESS_SHUTDOWN_TIMEOUT=30000

LOG_LEVEL=info
LOG_LEVEL_TEST=fatal
LOG_INCLUDE_TIMESTAMPS=false
LOG_COLORIZE=true

WEB_SERVER_ENABLED=true
WEB_SERVER_PORT=8080
# A random free port per test file.
WEB_SERVER_PORT_TEST=0
WEB_SERVER_HOST=localhost
WEB_SERVER_API_ROUTE="/api"
APPLICATION_URL=http://localhost:8080
# The frontend's origin: the base of every link in a notification e-mail.
FRONTEND_URL=http://localhost:3000
WEB_SERVER_ALLOWED_ORIGINS="http://localhost:3000"
WEB_SERVER_ALLOWED_METHODS="GET, POST, PUT, DELETE, OPTIONS"
# The OAuth authorize page's theme, generated from design/tokens.ts.
WEB_SERVER_THEME="theme/hypotenuse-theme.ts"

MCP_SERVER_ENABLED=true

SESSION_TTL=86400
SESSION_COOKIE_NAME="__session"

DATABASE_URL="postgres://localhost:5432/hypotenuse"
DATABASE_URL_TEST="postgres://localhost:5432/hypotenuse_test"
DATABASE_AUTO_MIGRATE=true

REDIS_URL="redis://localhost:6379/0"
REDIS_URL_TEST="redis://localhost:6379/1"

RATE_LIMIT_ENABLED=true
# Backend suites sign up many users from one address; the limiter would fail them.
RATE_LIMIT_ENABLED_TEST=false
RATE_LIMIT_WINDOW_MS=60000
# e2e signs up several users from one address inside a window.
RATE_LIMIT_UNAUTH_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=200

# AES-256-GCM key for every credential stored at rest (the Linear tokens first),
# base64 of exactly 32 bytes: `openssl rand -base64 32`. The process refuses to
# boot without a valid one. This development value is committed on purpose;
# deployed services read theirs from a shared env var group so web and worker
# agree on one key.
SECRETS_ENCRYPTION_KEY="dGVzdC1vbmx5LWtleS0zMi1ieXRlcy1sb25nISEhISE="

# How long audit rows live before the daily `audit:sweep` deletes them.
AUDIT_RETENTION_DAYS=90

# Notifications. With SMTP_HOST empty the transport LOGS instead of sending and
# marks the row `sent` — what keeps development and CI working with no mail
# server, and the mode the notification tests assert against. A deployment that
# lands in it warns once at boot.
#   bunx maildev   # then SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Hypotenuse <noreply@example.invalid>"
NOTIFICATION_DISPATCH_FREQUENCY_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DISPATCH_BATCH=100
NOTIFICATION_RETENTION_DAYS=30

TASKS_ENABLED=true
TASK_PROCESSORS=1
# Tests drive jobs in-process with `runAction`; a background worker would race them.
# The bare key above would otherwise beat the config's NODE_ENV=test default.
TASK_PROCESSORS_TEST=0
TASK_TIMEOUT=5000
TASK_TIMEOUT_TEST=100

# Linear — read by the Linear connection and webhook ingress. Empty until a Linear
# OAuth app exists (docs/DEPLOY.md). Tests point the URLs at an in-process finear.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_API_URL=https://api.linear.app
LINEAR_OAUTH_URL=https://linear.app
