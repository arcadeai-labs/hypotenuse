# One file covers development and test: `loadFromEnvIfSet` reads `${VAR}_${NODE_ENV}`
# before `${VAR}`, so the `_TEST` variants select themselves under `bun test`.

NODE_ENV=development
PROCESS_NAME=hypotenuse
PROCESS_NAME_TEST=hypotenuse-test
PROCESS_SHUTDOWN_TIMEOUT=30000

LOG_LEVEL=info
LOG_LEVEL_TEST=fatal
LOG_INCLUDE_TIMESTAMPS=false
LOG_COLORIZE=true

WEB_SERVER_ENABLED=true
WEB_SERVER_PORT=8080
# A random free port per test file.
WEB_SERVER_PORT_TEST=0
WEB_SERVER_HOST=localhost
WEB_SERVER_API_ROUTE="/api"
# The OAuth authorize page's theme, generated from design/tokens.ts. Keryx
# refuses to boot when this names a file that does not exist.
WEB_SERVER_THEME="theme/hypotenuse-theme.ts"
# This deployment's public origin: the base of every webhook URL a platform app's
# manifest embeds. While developing a platform app, set it to the ngrok tunnel
# (`bun run ngrok`), because no platform delivers to localhost.
APPLICATION_URL=http://localhost:8080
# The frontend's origin: the base of every dashboard link the server writes.
FRONTEND_URL=http://localhost:3000
WEB_SERVER_ALLOWED_ORIGINS="http://localhost:3000"
WEB_SERVER_ALLOWED_METHODS="GET, POST, PUT, DELETE, OPTIONS"

MCP_SERVER_ENABLED=true

SESSION_TTL=86400
SESSION_COOKIE_NAME="__session"

# Postgres with the `vector` extension available (`brew install pgvector`): the
# first migration creates it, and `/api/status` is unhealthy without it.
DATABASE_URL="postgres://localhost:5432/hypotenuse"
DATABASE_URL_TEST="postgres://localhost:5432/hypotenuse_test"
DATABASE_AUTO_MIGRATE=true

REDIS_URL="redis://localhost:6379/0"
REDIS_URL_TEST="redis://localhost:6379/1"

RATE_LIMIT_ENABLED=true
# Backend suites sign up many users from one address; the limiter would fail them.
RATE_LIMIT_ENABLED_TEST=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UNAUTH_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=200

# AES-256-GCM key for every credential stored at rest, base64 of exactly 32
# bytes: `openssl rand -base64 32`. Declared here before anything reads it, so
# every environment already carries one when stored credentials arrive. This
# development value is committed on purpose; deployed services read theirs from
# a shared env var group so web and worker agree on one key.
SECRETS_ENCRYPTION_KEY="dGVzdC1vbmx5LWtleS0zMi1ieXRlcy1sb25nISEhISE="

# The SSRF guard on URLs a person typed (a model provider's base URL): https only,
# and every address the host resolves to must be public. True lifts it, for a
# provider on this machine; it is true by default under test, where the scripted
# model server listens on loopback. Never set it in a deployment.
NETWORK_ALLOW_PRIVATE_HOSTS=false
NETWORK_ALLOW_PRIVATE_HOSTS_TEST=true
NETWORK_REQUEST_TIMEOUT_MS=30000

# Email notifications. Empty SMTP_HOST is log-only mode: `notifications:dispatch`
# logs each email and marks it sent, which is what development and CI run on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hypotenuse <noreply@example.invalid>"

TASKS_ENABLED=true
TASK_PROCESSORS=1
# Tests drive jobs in-process with `runAction`; a background worker would race them.
# The bare key above would otherwise beat the config's NODE_ENV=test default.
TASK_PROCESSORS_TEST=0
TASK_TIMEOUT=5000
TASK_TIMEOUT_TEST=100
