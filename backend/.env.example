# One file covers development and test: `loadFromEnvIfSet` reads `${VAR}_${NODE_ENV}`
# before `${VAR}`, so the `_TEST` variants select themselves under `bun test`.

NODE_ENV=development
PROCESS_NAME=hypotenuse
PROCESS_NAME_TEST=hypotenuse-test
PROCESS_SHUTDOWN_TIMEOUT=30000

LOG_LEVEL=info
LOG_LEVEL_TEST=fatal
LOG_INCLUDE_TIMESTAMPS=false
LOG_COLORIZE=true

WEB_SERVER_ENABLED=true
WEB_SERVER_PORT=8080
# A random free port per test file.
WEB_SERVER_PORT_TEST=0
WEB_SERVER_HOST=localhost
WEB_SERVER_API_ROUTE="/api"
APPLICATION_URL=http://localhost:8080
# The frontend's origin: the base of every link in a notification e-mail.
FRONTEND_URL=http://localhost:3000
WEB_SERVER_ALLOWED_ORIGINS="http://localhost:3000"
WEB_SERVER_ALLOWED_METHODS="GET, POST, PUT, DELETE, OPTIONS"
# The OAuth authorize page's theme, generated from design/tokens.ts.
WEB_SERVER_THEME="theme/hypotenuse-theme.ts"

MCP_SERVER_ENABLED=true

SESSION_TTL=86400
SESSION_COOKIE_NAME="__session"

DATABASE_URL="postgres://localhost:5432/hypotenuse"
DATABASE_URL_TEST="postgres://localhost:5432/hypotenuse_test"
DATABASE_AUTO_MIGRATE=true

REDIS_URL="redis://localhost:6379/0"
REDIS_URL_TEST="redis://localhost:6379/1"

RATE_LIMIT_ENABLED=true
# Backend suites sign up many users from one address; the limiter would fail them.
RATE_LIMIT_ENABLED_TEST=false
RATE_LIMIT_WINDOW_MS=60000
# e2e signs up several users from one address inside a window.
RATE_LIMIT_UNAUTH_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=200

# AES-256-GCM key for every credential stored at rest (the Linear tokens first),
# base64 of exactly 32 bytes: `openssl rand -base64 32`. The process refuses to
# boot without a valid one. This development value is committed on purpose;
# deployed services read theirs from a shared env var group so web and worker
# agree on one key.
SECRETS_ENCRYPTION_KEY="dGVzdC1vbmx5LWtleS0zMi1ieXRlcy1sb25nISEhISE="

# Signing in the `hypotenuse` CLI through the dashboard. The approval pages live
# at FRONTEND_URL; these are the lifetimes of the hand-offs and the token.
CLI_AUTH_CODE_TTL_SECONDS=60
CLI_AUTH_DEVICE_CODE_TTL_SECONDS=600
CLI_AUTH_POLL_INTERVAL_SECONDS=5
CLI_TOKEN_TTL_DAYS=90

# How long audit rows live before the daily `audit:sweep` deletes them.
AUDIT_RETENTION_DAYS=90

# Notifications. With SMTP_HOST empty the transport LOGS instead of sending and
# marks the row `sent` — what keeps development and CI working with no mail
# server, and the mode the notification tests assert against. A deployment that
# lands in it warns once at boot.
#   bunx maildev   # then SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Hypotenuse <noreply@example.invalid>"
NOTIFICATION_DISPATCH_FREQUENCY_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DISPATCH_BATCH=100
NOTIFICATION_RETENTION_DAYS=30

TASKS_ENABLED=true
TASK_PROCESSORS=1
# Tests drive jobs in-process with `runAction`; a background worker would race them.
# The bare key above would otherwise beat the config's NODE_ENV=test default.
TASK_PROCESSORS_TEST=0
TASK_TIMEOUT=5000
TASK_TIMEOUT_TEST=100

# Linear — read by the Linear connection and webhook ingress. Empty until a Linear
# OAuth app exists (docs/DEPLOY.md): create one with `bun keryx.ts linear:manifest-url`.
# Tests register these _TEST values as an OAuth client in an in-process finear,
# and point the URLs at it.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_ID_TEST=hypotenuse-test-client
LINEAR_CLIENT_SECRET=
LINEAR_CLIENT_SECRET_TEST=hypotenuse-test-client-secret
LINEAR_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET_TEST=hypotenuse-test-webhook-secret
LINEAR_API_URL=https://api.linear.app
LINEAR_OAUTH_URL=https://linear.app
# How long before expiry the refresh clock renews an access token, how long an
# install's `state` waits for its callback, how long `integration:catalog` is cached,
# and the deadline on every call to Linear.
LINEAR_REFRESH_WINDOW_MS=1800000
LINEAR_STATE_TTL_SECONDS=600
LINEAR_CATALOG_TTL_MS=60000
LINEAR_REQUEST_TIMEOUT_MS=10000
# Set only while rotating the webhook secret: deliveries signed with either verify.
LINEAR_WEBHOOK_SECRET_PREVIOUS=
# Webhook ingress: the largest delivery read (5 MiB, as @linear/sdk), how far the
# signed webhookTimestamp may be from now, and how long deliveries are kept.
LINEAR_WEBHOOK_MAX_BODY_BYTES=5242880
LINEAR_WEBHOOK_TOLERANCE_MS=60000
LINEAR_EVENT_RETENTION_DAYS=14
# The activity outbox's per-installation budget: Linear's 5,000 requests an hour
# per app user, a burst of 60, the last 10 kept for acknowledgements; and how
# many times a retryable failure is retried.
LINEAR_REQUESTS_PER_HOUR=5000
LINEAR_BUCKET_BURST=60
LINEAR_BUCKET_RESERVE=10
LINEAR_DELIVER_MAX_ATTEMPTS=10

# Runners. The heartbeat interval is the server's to choose (sent to every
# daemon); a runner silent for offlineAfter goes offline at the next work:reap
# tick. Per-runner request budgets are per minute, and stay on in tests.
RUNNER_HEARTBEAT_INTERVAL_MS=15000
RUNNER_OFFLINE_AFTER_MS=45000
RUNNER_LEASE_MS=60000
RUNNER_REAP_FREQUENCY_MS=15000
RUNNER_RATE_LIMIT_ENABLED=true
RUNNER_RATE_LIMIT_WINDOW_MS=60000
RUNNER_HEARTBEAT_LIMIT=12
RUNNER_REQUEST_LIMIT=600

# Work routing. `work:route` also runs whenever something could make work
# placeable; this clock is the backstop. `sessions:keepalive` looks for sessions
# waiting for a runner that have gone quiet. Per-project timers (queue, sticky,
# offer, stop grace) are project settings, not env.
ROUTING_FREQUENCY_MS=5000
ROUTING_KEEPALIVE_FREQUENCY_MS=60000
