{
  "name": "@arcadeai/hypotenuse",
  "version": "0.9.0",
  "description": "Hypotenuse — run coding agents on your machine for Linear agent sessions",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "hypotenuse": "./dist/hypotenuse.js"
  },
  "files": [
    "dist/hypotenuse.js",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadeai-labs/hypotenuse.git"
  },
  "homepage": "https://github.com/arcadeai-labs/hypotenuse#readme",
  "bugs": {
    "url": "https://github.com/arcadeai-labs/hypotenuse/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "hypotenuse": "bun run src/cli.ts",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "tsc && biome check .",
    "format": "tsc && biome check --write .",
    "bundle": "bun build ./src/cli.ts --target bun --packages external --outfile dist/hypotenuse.js",
    "build": "bun build --compile --minify --sourcemap ./src/cli.ts --outfile dist/hypotenuse",
    "prepack": "bun run bundle"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^14.0.3",
    "nanospinner": "^1.2.2",
    "smol-toml": "^1.9.1",
    "upgradr": "^0.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
