{
  "authMethods": [
    {
      "id": "terminal-login",
      "name": "Log in in a terminal",
      "type": "terminal",
      "args": ["--login"]
    }
  ],
  "authRequired": "until-login",
  "turns": [
    [
      {
        "update": {
          "sessionUpdate": "agent_message_chunk",
          "content": { "type": "text", "text": "Signed in and finished." }
        }
      },
      { "stop": "end_turn" }
    ]
  ]
}
