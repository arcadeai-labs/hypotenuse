# Copy to `.env` for local development: `cp .env.example .env`

# Inlined into the bundle at BUILD time, not read at runtime — changing it
# requires a rebuild, not a restart.
VITE_API_URL=http://localhost:8080

# Vite dev-server port. Must match the backend's WEB_SERVER_ALLOWED_ORIGINS.
PORT=3000

# The ngrok frontend tunnel's host (no scheme), so Vite accepts it and HMR goes
# through it. Empty when not tunnelling; see docs/DEPLOY.md.
VITE_DEV_TUNNEL_HOST=

# Ports the browser suite starts its own backend and dev server on, so a suite
# run never takes the ports `bun dev` is using. `bun run workspace:setup`
# rewrites them per worktree.
E2E_BACKEND_PORT=8081
E2E_FRONTEND_PORT=3001
