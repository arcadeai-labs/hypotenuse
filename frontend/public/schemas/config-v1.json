{
  "$id": "https://www.hypotenuse.cloud/schemas/config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "The config format; must be 1"
    },
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "url": {
          "description": "The Hypotenuse server",
          "type": "string",
          "format": "uri"
        },
        "project": {
          "description": "The runner's project, by slug or id",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "default": "runner",
          "description": "Display name",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_parallel_jobs": {
          "default": 1,
          "description": "Jobs running at once on this machine",
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "roles": {
          "default": [
            "worker"
          ],
          "description": "The roles this runner plays",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "manager",
              "worker"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "subscriptions": {
      "default": {},
      "type": "object",
      "properties": {
        "teams": {
          "default": [],
          "description": "Linear team keys",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projects": {
          "default": [],
          "description": "Linear project ids or names",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels": {
          "default": [],
          "description": "Label names; an issue needs one",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "preset": {
            "description": "A built-in agent launch command",
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "gemini",
              "copilot",
              "goose",
              "opencode",
              "cursor",
              "qwen",
              "cline",
              "auggie",
              "kilo"
            ]
          },
          "command": {
            "description": "The full launch command of an ACP agent on stdio",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "args": {
            "default": [],
            "description": "Appended to the preset's or command's arguments",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "env": {
            "default": {},
            "description": "Added to the agent's environment; $VAR allowed",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "auth_method": {
            "description": "Which advertised ACP authMethod to use",
            "type": "string",
            "minLength": 1
          },
          "startup_timeout": {
            "description": "Time allowed to answer initialize",
            "default": "60s",
            "type": "string",
            "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
          },
          "max_parallel": {
            "description": "Jobs using this agent at once",
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "default": {},
      "type": "object",
      "properties": {
        "manager": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "description": "An [agents.<id>] id or a preset name"
            },
            "prompt": {
              "description": "The role's entry prompt template, inline",
              "type": "string",
              "minLength": 1
            },
            "prompt_file": {
              "description": "A Markdown prompt template file",
              "type": "string",
              "minLength": 1
            },
            "permission_policy": {
              "default": "ask",
              "description": "allow, ask, or deny every permission request — or a table by ACP tool kind, e.g. { default = \"allow\", execute = \"ask\" }",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "default": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "read": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "edit": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "delete": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "move": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "search": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "execute": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "think": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "fetch": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "other": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "max_parallel": {
              "description": "Jobs of this role at once",
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "mode": {
              "description": "The ACP session mode to select",
              "type": "string",
              "minLength": 1
            },
            "turn_timeout": {
              "description": "Overrides [sessions] turn_timeout",
              "type": "string",
              "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
            },
            "additional_directories": {
              "description": "Extra directories the agent may read and write",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "extra_mcp_servers": {
              "default": [],
              "description": "More MCP servers for the agent",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unique within the role; `hypotenuse` is reserved"
                  },
                  "command": {
                    "description": "A stdio MCP server's command",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "env": {
                    "description": "Added to the server's environment; $VAR allowed",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "url": {
                    "description": "An HTTP MCP server's URL",
                    "type": "string",
                    "format": "uri"
                  },
                  "headers": {
                    "description": "HTTP headers; $VAR allowed",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "agent"
          ],
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "description": "An [agents.<id>] id or a preset name"
            },
            "prompt": {
              "description": "The role's entry prompt template, inline",
              "type": "string",
              "minLength": 1
            },
            "prompt_file": {
              "description": "A Markdown prompt template file",
              "type": "string",
              "minLength": 1
            },
            "permission_policy": {
              "default": "allow",
              "description": "allow, ask, or deny every permission request — or a table by ACP tool kind, e.g. { default = \"allow\", execute = \"ask\" }",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "default": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "read": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "edit": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "delete": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "move": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "search": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "execute": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "think": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "fetch": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    "other": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "max_parallel": {
              "description": "Jobs of this role at once",
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "mode": {
              "description": "The ACP session mode to select",
              "type": "string",
              "minLength": 1
            },
            "turn_timeout": {
              "description": "Overrides [sessions] turn_timeout",
              "type": "string",
              "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
            },
            "additional_directories": {
              "description": "Extra directories the agent may read and write",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "extra_mcp_servers": {
              "default": [],
              "description": "More MCP servers for the agent",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unique within the role; `hypotenuse` is reserved"
                  },
                  "command": {
                    "description": "A stdio MCP server's command",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "env": {
                    "description": "Added to the server's environment; $VAR allowed",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "url": {
                    "description": "An HTTP MCP server's URL",
                    "type": "string",
                    "format": "uri"
                  },
                  "headers": {
                    "description": "HTTP headers; $VAR allowed",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "agent"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Unique; used in worktree paths",
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "description": "An existing git clone",
            "type": "string",
            "minLength": 1
          },
          "remote": {
            "description": "The repository's remote; must match origin",
            "type": "string",
            "minLength": 1
          },
          "base_branch": {
            "description": "The branch worktrees start from",
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "default": [],
            "description": "Shell commands run in each new worktree",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "setup_timeout": {
            "description": "Per setup command",
            "default": "10m",
            "type": "string",
            "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
          },
          "branch_prefix": {
            "default": "hypotenuse",
            "description": "Branch name prefix",
            "type": "string",
            "minLength": 1
          },
          "worktrees": {
            "description": "Overrides [sessions] worktrees",
            "type": "string",
            "enum": [
              "always",
              "never"
            ]
          },
          "cleanup": {
            "description": "Overrides [sessions] cleanup",
            "type": "string",
            "enum": [
              "on-complete",
              "on-merge",
              "ttl",
              "never"
            ]
          },
          "pr_url_patterns": {
            "default": [],
            "description": "Extra PR URL regexes for self-hosted forges",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "sessions": {
      "default": {},
      "type": "object",
      "properties": {
        "worktrees": {
          "default": "always",
          "description": "Whether sessions get a worktree",
          "type": "string",
          "enum": [
            "always",
            "never"
          ]
        },
        "worktree_root": {
          "description": "Where worktrees live",
          "default": "~/.hypotenuse/worktrees",
          "type": "string",
          "minLength": 1
        },
        "cleanup": {
          "default": "on-complete",
          "description": "When a worktree may be removed",
          "type": "string",
          "enum": [
            "on-complete",
            "on-merge",
            "ttl",
            "never"
          ]
        },
        "cleanup_ttl": {
          "description": "Required for cleanup = ttl",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "cleanup_grace": {
          "description": "Wait after completion before cleanup",
          "default": "1h",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "turn_timeout": {
          "description": "Longest turn",
          "default": "60m",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "idle_timeout": {
          "description": "Longest silence",
          "default": "15m",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "keepalive_interval": {
          "description": "Silence before a keepalive thought",
          "default": "10m",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "stop_grace": {
          "description": "Wind-down time after a stop",
          "default": "10s",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)(ms|s|m|h|d)$"
        },
        "min_free_disk": {
          "description": "Free space needed for a new worktree",
          "default": "2GB",
          "type": "string",
          "pattern": "^(\\d+(?:\\.\\d+)?)\\s*(B|KB|MB|GB|TB)$"
        }
      },
      "additionalProperties": false
    },
    "log": {
      "default": {},
      "type": "object",
      "properties": {
        "level": {
          "default": "info",
          "description": "Log level",
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ]
        },
        "file": {
          "description": "The daemon log file",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "config_version"
  ],
  "additionalProperties": false
}
