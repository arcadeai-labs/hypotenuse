{
  "name": "hypotenuse-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test src/__tests__",
    "lint": "bun run theme:check && tsc -b && biome check .",
    "format": "biome check --write .",
    "theme:build": "bun ../design/tokens.ts --write",
    "theme:check": "bun ../design/tokens.ts --check",
    "test:e2e": "playwright test",
    "docs:illustrations": "bun scripts/capture-doc-illustrations.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "keryx": "^0.48.0",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
